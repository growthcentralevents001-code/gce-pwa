# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
.playwright/
.env.test.local

# next.js
/.next/
/.next.prev/
/.next.prev.bak/
/.next.bad/
/.next.selftest-incoming/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

.env
.env.*
!.env.example

# Supabase CLI local temp (machine-specific; do not commit)
supabase/.temp/

# Python bytecode
__pycache__/
*.py[cod]
