"use client";

import { useState, useEffect } from "react";
import { supabase } from "@/lib/supabaseClient";

export default function EnterpriseProposals() {
  const [requests, setRequests] = useState([]);
  const [loading, setLoading] = useState(true);
  const [editingId, setEditingId] = useState(null);
  const [editData, setEditData] = useState({
    proposal_text: "",
    amount: "",
    admin_notes: "",
    final_budget: "",
  });

  useEffect(() => {
    fetchRequests();
  }, []);

  const fetchRequests = async () => {
    setLoading(true);
    // Fetch pending enterprise requests (not yet converted to proposals)
    const { data, error } = await supabase
      .from("enterprise_requests")
      .select("*")
      .eq("status", "pending")
      .order("created_at", { ascending: false });

    if (!error) setRequests(data || []);
    setLoading(false);
  };

  const handleEdit = (req) => {
    setEditingId(req.id);
    setEditData({
      proposal_text: "",
      amount: "",
      admin_notes: "",
      final_budget: "",
    });
  };

  const handleSendProposal = async (requestId) => {
    if (!editData.proposal_text || !editData.amount) {
      alert("Please fill in proposal text and amount.");
      return;
    }

    // 1. Insert into enterprise_proposals
    const { error: propError } = await supabase
      .from("enterprise_proposals")
      .insert({
        request_id: requestId,
        proposal_text: editData.proposal_text,
        amount: parseFloat(editData.amount),
        admin_notes: editData.admin_notes || null,
        final_budget: editData.final_budget ? parseFloat(editData.final_budget) : null,
        status: "pending",
        user_id: (await supabase.auth.getUser()).data.user?.id,
      });

    if (propError) {
      alert("Error creating proposal: " + propError.message);
      return;
    }

    // 2. Update request status to 'proposed'
    const { error: reqError } = await supabase
      .from("enterprise_requests")
      .update({ status: "proposed" })
      .eq("id", requestId);

    if (reqError) {
      alert("Error updating request status: " + reqError.message);
      return;
    }

    alert("Proposal sent to enterprise!");
    setEditingId(null);
    fetchRequests();
  };

  const handleRejectRequest = async (requestId) => {
    if (confirm("Reject this request?")) {
      const { error } = await supabase
        .from("enterprise_requests")
        .update({ status: "rejected" })
        .eq("id", requestId);
      if (error) alert("Error: " + error.message);
      else fetchRequests();
    }
  };

  if (loading) return <div className="p-6">Loading requests...</div>;

  return (
    <div className="p-6 max-w-6xl mx-auto">
      <h1 className="text-2xl font-bold mb-6">Enterprise Requests (Pending)</h1>
      
      {requests.length === 0 ? (
        <p className="text-gray-500">No pending enterprise requests.</p>
      ) : (
        <div className="space-y-4">
          {requests.map((req) => (
            <div key={req.id} className="bg-white rounded-lg shadow p-4 border">
              <div className="flex justify-between items-start">
                <div>
                  <h2 className="text-lg font-semibold">{req.event_type}</h2>
                  <p className="text-sm text-gray-600">
                    {req.guest_count} guests · {req.budget_range} · {req.city}
                  </p>
                  <p className="text-xs text-gray-400">Dates: {req.preferred_dates}</p>
                  <p className="text-xs text-gray-400 mt-1">Status: <span className="text-yellow-600 font-medium">{req.status}</span></p>
                </div>
                <div className="flex gap-2">
                  <button
                    onClick={() => handleEdit(req)}
                    className="px-3 py-1 bg-orange-600 text-white rounded-lg text-sm"
                  >
                    Create Proposal
                  </button>
                  <button
                    onClick={() => handleRejectRequest(req.id)}
                    className="px-3 py-1 bg-red-600 text-white rounded-lg text-sm"
                  >
                    Reject
                  </button>
                </div>
              </div>

              {/* Proposal Form */}
              {editingId === req.id && (
                <div className="mt-4 p-4 bg-gray-50 rounded-lg border">
                  <h3 className="font-medium mb-2">Create Proposal</h3>
                  <div className="space-y-3">
                    <div>
                      <label className="block text-sm font-medium text-gray-700">Proposal Text *</label>
                      <textarea
                        value={editData.proposal_text}
                        onChange={(e) => setEditData({...editData, proposal_text: e.target.value})}
                        className="w-full p-2 border rounded-lg"
                        rows="3"
                        placeholder="Describe the proposal..."
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700">Amount (₹) *</label>
                      <input
                        type="number"
                        value={editData.amount}
                        onChange={(e) => setEditData({...editData, amount: e.target.value})}
                        className="w-full p-2 border rounded-lg"
                        placeholder="Enter amount"
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700">Admin Notes (optional)</label>
                      <textarea
                        value={editData.admin_notes}
                        onChange={(e) => setEditData({...editData, admin_notes: e.target.value})}
                        className="w-full p-2 border rounded-lg"
                        rows="2"
                        placeholder="Any internal notes..."
                      />
                    </div>
                    <div>
                      <label className="block text-sm font-medium text-gray-700">Final Budget (optional)</label>
                      <input
                        type="number"
                        value={editData.final_budget}
                        onChange={(e) => setEditData({...editData, final_budget: e.target.value})}
                        className="w-full p-2 border rounded-lg"
                        placeholder="Enter final budget"
                      />
                    </div>
                    <div className="flex gap-2">
                      <button
                        onClick={() => handleSendProposal(req.id)}
                        className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700"
                      >
                        Send Proposal
                      </button>
                      <button
                        onClick={() => setEditingId(null)}
                        className="px-4 py-2 bg-gray-300 rounded-lg hover:bg-gray-400"
                      >
                        Cancel
                      </button>
                    </div>
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
