"use client";

import { useState } from "react";
import { 
  Building2, Calendar, TrendingUp, CreditCard, Plus, 
  Eye, Edit, Trash2, Trophy, CheckCircle, AlertCircle, 
  X, Save, MapPin, Star, Users, DollarSign, Award,
  FileText, Send, Filter, Download, Bell
} from "lucide-react";

export default function EnterpriseDashboard() {
  const [activeTab, setActiveTab] = useState("requests");
  const [showRequestModal, setShowRequestModal] = useState(false);
  const [showOfferModal, setShowOfferModal] = useState(false);
  
  // Event Requests State
  const [requests, setRequests] = useState([
    { id: 1, company: "TechCorp India", eventType: "Sales Training", cities: "Mumbai, Delhi, Bangalore", dates: "15-20 Jun 2025", headcount: 150, budget: "₹15,00,000", status: "Pending", submitted: "20 May 2025" },
    { id: 2, company: "FinTech Solutions", eventType: "Leadership Offsite", cities: "Goa", dates: "5-7 Jul 2025", headcount: 50, budget: "₹25,00,000", status: "Approved", submitted: "18 May 2025" },
    { id: 3, company: "SaaS Corp", eventType: "Product Launch", cities: "Mumbai, Pune", dates: "10 Jun 2025", headcount: 200, budget: "₹20,00,000", status: "In Progress", submitted: "15 May 2025" },
  ]);

  // Proposals State
  const [proposals, setProposals] = useState([
    { id: 1, requestId: 1, eventName: "Sales Training", amount: "₹14,50,000", status: "Sent", sentDate: "22 May 2025" },
    { id: 2, requestId: 2, eventName: "Leadership Offsite", amount: "₹24,00,000", status: "Accepted", sentDate: "20 May 2025" },
  ]);

  // Offers State
  const [offers, setOffers] = useState([
    { id: 1, name: "20% OFF on Business Events", type: "Discount", discount: "20%", target: "Fintech, SaaS", validTill: "30 Jun 2025", redeemed: 45, total: 200, status: "Active" },
    { id: 2, name: "Buy 1 Get 1 Free", type: "Free Units", discount: "BOGO", target: "All Members", validTill: "15 Jul 2025", redeemed: 128, total: 500, status: "Active" },
  ]);

  const [pastEvents] = useState([
    { id: 1, name: "AI Summit 2024", date: "15 Dec 2024", cities: "Mumbai, Bangalore", attendees: 450, revenue: "₹32,00,000" },
    { id: 2, name: "Women in Tech", date: "10 Oct 2024", cities: "Delhi, Pune", attendees: 280, revenue: "₹18,50,000" },
  ]);

  const [newRequest, setNewRequest] = useState({
    company: "", eventType: "Sales Training", cities: "", dates: "", headcount: "", budget: ""
  });

  const [newOffer, setNewOffer] = useState({
    name: "", type: "Discount", discount: "", target: "", validTill: "", total: 100
  });

  const stats = [
    { label: "Active Requests", value: requests.length.toString(), icon: FileText, color: "#f97316" },
    { label: "Approved Proposals", value: proposals.filter(p => p.status === "Accepted").length.toString(), icon: CheckCircle, color: "#22c55e" },
    { label: "Active Offers", value: offers.length.toString(), icon: Tag, color: "#3b82f6" },
    { label: "Total Spent", value: "₹74,50,000", icon: DollarSign, color: "#8b5cf6" },
  ];

  const getStatusBadge = (status: string) => {
    switch(status) {
      case "Pending": return { bg: "#fef3c7", color: "#92400e", icon: <AlertCircle size={12} /> };
      case "Approved": return { bg: "#dcfce7", color: "#166534", icon: <CheckCircle size={12} /> };
      case "In Progress": return { bg: "#e0e7ff", color: "#3730a3", icon: <AlertCircle size={12} /> };
      case "Active": return { bg: "#dcfce7", color: "#166534", icon: <CheckCircle size={12} /> };
      default: return { bg: "#f1f5f9", color: "#475569", icon: null };
    }
  };

  const handleAddRequest = () => {
    if (!newRequest.company || !newRequest.cities) {
      alert("Please fill company name and cities");
      return;
    }
    const newId = requests.length + 1;
    setRequests([...requests, {
      id: newId, company: newRequest.company, eventType: newRequest.eventType,
      cities: newRequest.cities, dates: newRequest.dates || "TBD",
      headcount: parseInt(newRequest.headcount) || 0, budget: newRequest.budget || "TBD",
      status: "Pending", submitted: new Date().toLocaleDateString()
    }]);
    setShowRequestModal(false);
    setNewRequest({ company: "", eventType: "Sales Training", cities: "", dates: "", headcount: "", budget: "" });
    alert("Event request submitted successfully!");
  };

  const handleAddOffer = () => {
    if (!newOffer.name || !newOffer.discount) {
      alert("Please fill offer name and discount");
      return;
    }
    const newId = offers.length + 1;
    setOffers([...offers, {
      id: newId, name: newOffer.name, type: newOffer.type,
      discount: newOffer.discount, target: newOffer.target || "All Members",
      validTill: newOffer.validTill || "30 Jun 2025", redeemed: 0,
      total: newOffer.total, status: "Pending"
    }]);
    setShowOfferModal(false);
    setNewOffer({ name: "", type: "Discount", discount: "", target: "", validTill: "", total: 100 });
    alert("Offer created! Pending admin approval.");
  };

  const handleCreateProposal = (requestId: number) => {
    alert(`Creating proposal for request #${requestId}. Feature coming soon!`);
  };

  const handleApproveOffer = (id: number) => {
    setOffers(offers.map(o => o.id === id ? { ...o, status: "Active" } : o));
    alert("Offer approved and live!");
  };

  return (
    <div style={{ maxWidth: "1280px", margin: "0 auto", padding: "24px", background: "#f8fafc", minHeight: "100vh" }}>
      {/* Header */}
      <div style={{ marginBottom: "32px" }}>
        <h1 style={{ fontSize: "28px", fontWeight: "700", color: "#0f172a" }}>Enterprise Dashboard</h1>
        <p style={{ color: "#64748b" }}>Manage event requests, proposals, and member offers</p>
      </div>

      {/* Stats */}
      <div style={{ display: "grid", gridTemplateColumns: "repeat(4, 1fr)", gap: "20px", marginBottom: "32px" }}>
        {stats.map((stat, i) => (
          <div key={i} style={{ background: "white", borderRadius: "20px", padding: "20px", border: "1px solid #eef2ff" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <div>
                <div style={{ fontSize: "24px", fontWeight: "800", color: "#0f172a" }}>{stat.value}</div>
                <div style={{ color: "#64748b", fontSize: "14px", marginTop: "4px" }}>{stat.label}</div>
              </div>
              <stat.icon size={28} style={{ color: stat.color, opacity: 0.7 }} />
            </div>
          </div>
        ))}
      </div>

      {/* Tabs */}
      <div style={{ display: "flex", gap: "12px", borderBottom: "1px solid #e2e8f0", marginBottom: "24px", overflowX: "auto" }}>
        {["requests", "proposals", "offers", "pastevents"].map(tab => (
          <button key={tab} onClick={() => setActiveTab(tab)} style={{
            padding: "10px 20px", border: "none", background: "none",
            borderBottom: activeTab === tab ? "2px solid #f97316" : "none",
            color: activeTab === tab ? "#f97316" : "#64748b", fontWeight: "500", cursor: "pointer"
          }}>
            {tab === "requests" ? "Event Requests" : tab === "proposals" ? "Proposals" : tab === "offers" ? "My Offers" : "Past Events"}
          </button>
        ))}
        <button onClick={() => setShowRequestModal(true)} style={{ marginLeft: "auto", background: "#f97316", color: "white", border: "none", padding: "8px 20px", borderRadius: "40px", cursor: "pointer", display: "flex", alignItems: "center", gap: "6px" }}>
          <Plus size={16} /> New Request
        </button>
      </div>

      {/* Event Requests Tab */}
      {activeTab === "requests" && (
        <div style={{ background: "white", borderRadius: "20px", overflow: "auto", border: "1px solid #eef2ff" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", minWidth: "800px" }}>
            <thead>
              <tr style={{ background: "#f8fafc", borderBottom: "1px solid #eef2ff" }}>
                <th style={{ padding: "16px", textAlign: "left" }}>Company</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Event Type</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Cities</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Dates</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Budget</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Status</th>
                <th style={{ padding: "16px", textAlign: "center" }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {requests.map(req => {
                const statusStyle = getStatusBadge(req.status);
                return (
                  <tr key={req.id} style={{ borderBottom: "1px solid #eef2ff" }}>
                    <td style={{ padding: "16px" }}><div style={{ fontWeight: "600" }}>{req.company}</div><div style={{ fontSize: "12px", color: "#64748b" }}>Submitted: {req.submitted}</div></td>
                    <td style={{ padding: "16px" }}>{req.eventType}</td>
                    <td style={{ padding: "16px" }}>{req.cities}</td>
                    <td style={{ padding: "16px" }}>{req.dates}</td>
                    <td style={{ padding: "16px", fontWeight: "600", color: "#22c55e" }}>{req.budget}</td>
                    <td style={{ padding: "16px" }}><span style={{ background: statusStyle.bg, color: statusStyle.color, padding: "4px 12px", borderRadius: "20px", fontSize: "12px", display: "inline-flex", alignItems: "center", gap: "4px" }}>{statusStyle.icon} {req.status}</span></td>
                    <td style={{ padding: "16px", textAlign: "center" }}>
                      <div style={{ display: "flex", gap: "8px", justifyContent: "center" }}>
                        <button onClick={() => handleCreateProposal(req.id)} style={{ background: "#f97316", color: "white", border: "none", padding: "4px 12px", borderRadius: "20px", cursor: "pointer", fontSize: "11px" }}>Create Proposal</button>
                      </div>
                    </td>
                  </td>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {/* Proposals Tab */}
      {activeTab === "proposals" && (
        <div style={{ background: "white", borderRadius: "20px", overflow: "auto", border: "1px solid #eef2ff" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", minWidth: "600px" }}>
            <thead>
              <tr style={{ background: "#f8fafc", borderBottom: "1px solid #eef2ff" }}>
                <th style={{ padding: "16px", textAlign: "left" }}>Event Name</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Amount</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Status</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Sent Date</th>
                <th style={{ padding: "16px", textAlign: "center" }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {proposals.map(prop => (
                <tr key={prop.id} style={{ borderBottom: "1px solid #eef2ff" }}>
                  <td style={{ padding: "16px" }}>{prop.eventName}</td>
                  <td style={{ padding: "16px", fontWeight: "600", color: "#22c55e" }}>{prop.amount}</td>
                  <td style={{ padding: "16px" }}><span style={{ background: "#dcfce7", color: "#166534", padding: "4px 12px", borderRadius: "20px", fontSize: "12px" }}>{prop.status}</span></td>
                  <td style={{ padding: "16px" }}>{prop.sentDate}</td>
                  <td style={{ padding: "16px", textAlign: "center" }}>
                    <button style={{ background: "#f97316", color: "white", border: "none", padding: "4px 12px", borderRadius: "20px", cursor: "pointer", fontSize: "11px" }}>View Details</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* Offers Tab */}
      {activeTab === "offers" && (
        <div style={{ background: "white", borderRadius: "20px", overflow: "auto", border: "1px solid #eef2ff" }}>
          <div style={{ padding: "16px", display: "flex", justifyContent: "flex-end" }}>
            <button onClick={() => setShowOfferModal(true)} style={{ background: "#f97316", color: "white", border: "none", padding: "8px 20px", borderRadius: "40px", cursor: "pointer", display: "flex", alignItems: "center", gap: "6px" }}>
              <Plus size={16} /> Create Offer
            </button>
          </div>
          <table style={{ width: "100%", borderCollapse: "collapse", minWidth: "700px" }}>
            <thead>
              <tr style={{ background: "#f8fafc", borderBottom: "1px solid #eef2ff" }}>
                <th style={{ padding: "16px", textAlign: "left" }}>Offer Name</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Type</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Discount</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Target</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Redeemed</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Status</th>
                <th style={{ padding: "16px", textAlign: "center" }}>Actions</th>
              </tr>
            </thead>
            <tbody>
              {offers.map(offer => {
                const statusStyle = getStatusBadge(offer.status);
                return (
                  <tr key={offer.id} style={{ borderBottom: "1px solid #eef2ff" }}>
                    <td style={{ padding: "16px" }}><div style={{ fontWeight: "600" }}>{offer.name}</div></td>
                    <td style={{ padding: "16px" }}>{offer.type}</td>
                    <td style={{ padding: "16px", fontWeight: "600", color: "#f97316" }}>{offer.discount}</td>
                    <td style={{ padding: "16px" }}>{offer.target}</td>
                    <td style={{ padding: "16px" }}>{offer.redeemed} / {offer.total}</td>
                    <td style={{ padding: "16px" }}><span style={{ background: statusStyle.bg, color: statusStyle.color, padding: "4px 12px", borderRadius: "20px", fontSize: "12px" }}>{statusStyle.icon} {offer.status}</span></td>
                    <td style={{ padding: "16px", textAlign: "center" }}>
                      <div style={{ display: "flex", gap: "8px", justifyContent: "center" }}>
                        {offer.status === "Pending" && (
                          <button onClick={() => handleApproveOffer(offer.id)} style={{ background: "#dcfce7", color: "#166534", border: "none", padding: "4px 12px", borderRadius: "20px", cursor: "pointer", fontSize: "11px" }}>Activate</button>
                        )}
                      </div>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}

      {/* Past Events Tab */}
      {activeTab === "pastevents" && (
        <div style={{ background: "white", borderRadius: "20px", overflow: "auto", border: "1px solid #eef2ff" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", minWidth: "600px" }}>
            <thead>
              <tr style={{ background: "#f8fafc", borderBottom: "1px solid #eef2ff" }}>
                <th style={{ padding: "16px", textAlign: "left" }}>Event Name</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Date</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Cities</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Attendees</th>
                <th style={{ padding: "16px", textAlign: "left" }}>Revenue</th>
              </tr>
            </thead>
            <tbody>
              {pastEvents.map(event => (
                <tr key={event.id} style={{ borderBottom: "1px solid #eef2ff" }}>
                  <td style={{ padding: "16px", fontWeight: "600" }}>{event.name}</td>
                  <td style={{ padding: "16px" }}>{event.date}</td>
                  <td style={{ padding: "16px" }}>{event.cities}</td>
                  <td style={{ padding: "16px" }}>{event.attendees}</td>
                  <td style={{ padding: "16px", fontWeight: "600", color: "#22c55e" }}>{event.revenue}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {/* Request Modal */}
      {showRequestModal && (
        <div style={{ position: "fixed", top: 0, left: 0, right: 0, bottom: 0, background: "rgba(0,0,0,0.5)", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 1000 }}>
          <div style={{ background: "white", borderRadius: "24px", padding: "32px", maxWidth: "500px", width: "90%" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "24px" }}>
              <h2 style={{ fontSize: "22px", fontWeight: "700" }}>New Event Request</h2>
              <button onClick={() => setShowRequestModal(false)} style={{ background: "none", border: "none", fontSize: "24px", cursor: "pointer" }}><X size={24} /></button>
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="text" placeholder="Company Name *" value={newRequest.company} onChange={(e) => setNewRequest({...newRequest, company: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px" }}>
              <select value={newRequest.eventType} onChange={(e) => setNewRequest({...newRequest, eventType: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }}>
                <option>Sales Training</option><option>Leadership Offsite</option><option>Product Launch</option><option>Team Building</option>
              </select>
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="text" placeholder="Cities (comma separated) *" value={newRequest.cities} onChange={(e) => setNewRequest({...newRequest, cities: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="text" placeholder="Dates (e.g., 15-20 Jun 2025)" value={newRequest.dates} onChange={(e) => setNewRequest({...newRequest, dates: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="number" placeholder="Headcount" value={newRequest.headcount} onChange={(e) => setNewRequest({...newRequest, headcount: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "24px" }}>
              <input type="text" placeholder="Budget Range" value={newRequest.budget} onChange={(e) => setNewRequest({...newRequest, budget: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ display: "flex", gap: "12px" }}>
              <button onClick={handleAddRequest} style={{ flex: 1, background: "#f97316", color: "white", border: "none", padding: "12px", borderRadius: "40px", cursor: "pointer" }}>Submit Request</button>
              <button onClick={() => setShowRequestModal(false)} style={{ flex: 1, background: "#f1f5f9", color: "#64748b", border: "none", padding: "12px", borderRadius: "40px", cursor: "pointer" }}>Cancel</button>
            </div>
          </div>
        </div>
      )}

      {/* Offer Modal */}
      {showOfferModal && (
        <div style={{ position: "fixed", top: 0, left: 0, right: 0, bottom: 0, background: "rgba(0,0,0,0.5)", display: "flex", alignItems: "center", justifyContent: "center", zIndex: 1000 }}>
          <div style={{ background: "white", borderRadius: "24px", padding: "32px", maxWidth: "500px", width: "90%" }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "24px" }}>
              <h2 style={{ fontSize: "22px", fontWeight: "700" }}>Create Offer for Members</h2>
              <button onClick={() => setShowOfferModal(false)} style={{ background: "none", border: "none", fontSize: "24px", cursor: "pointer" }}><X size={24} /></button>
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="text" placeholder="Offer Name *" value={newOffer.name} onChange={(e) => setNewOffer({...newOffer, name: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px", display: "flex", gap: "12px" }}>
              <select value={newOffer.type} onChange={(e) => setNewOffer({...newOffer, type: e.target.value})} style={{ flex: 1, padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }}>
                <option>Discount</option><option>Free Units</option>
              </select>
              <input type="text" placeholder="e.g., 20% or ₹100" value={newOffer.discount} onChange={(e) => setNewOffer({...newOffer, discount: e.target.value})} style={{ flex: 1, padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px" }}>
              <input type="text" placeholder="Target Interests (e.g., Fintech, SaaS)" value={newOffer.target} onChange={(e) => setNewOffer({...newOffer, target: e.target.value})} style={{ width: "100%", padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ marginBottom: "16px", display: "flex", gap: "12px" }}>
              <input type="text" placeholder="Valid Till (e.g., 30 Jun 2025)" value={newOffer.validTill} onChange={(e) => setNewOffer({...newOffer, validTill: e.target.value})} style={{ flex: 1, padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
              <input type="number" placeholder="Total Units" value={newOffer.total} onChange={(e) => setNewOffer({...newOffer, total: parseInt(e.target.value)})} style={{ flex: 1, padding: "12px", borderRadius: "12px", border: "1px solid #e2e8f0" }} />
            </div>
            <div style={{ display: "flex", gap: "12px" }}>
              <button onClick={handleAddOffer} style={{ flex: 1, background: "#f97316", color: "white", border: "none", padding: "12px", borderRadius: "40px", cursor: "pointer" }}>Create Offer</button>
              <button onClick={() => setShowOfferModal(false)} style={{ flex: 1, background: "#f1f5f9", color: "#64748b", border: "none", padding: "12px", borderRadius: "40px", cursor: "pointer" }}>Cancel</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
