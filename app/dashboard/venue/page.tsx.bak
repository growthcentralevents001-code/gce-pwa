"use client";
import { useEffect, useState } from "react";
import { supabase } from "@/lib/supabaseClient";
import { useRouter } from "next/navigation";

export default function VenueDashboard() {
  const router = useRouter();
  const [venue, setVenue] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [referralError, setReferralError] = useState("");
  const [form, setForm] = useState({
    name: "",
    city: "",
    address: "",
    capacity: "",
    type: "",
    referral_code: "",
  });

  useEffect(() => { fetchVenue(); }, []);

  async function fetchVenue() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { router.push("/login"); return; }
    const { data } = await supabase.from("venues").select("*").eq("user_id", user.id).maybeSingle();
    if (data) {
      setVenue(data);
      setForm({
        name: data.name || "",
        city: data.city || "",
        address: data.address || "",
        capacity: data.capacity || "",
        type: data.type || "",
        referral_code: "",
      });
    }
    setLoading(false);
  }

  async function validateReferralCode(code: string) {
    if (!code) return null;
    const cleanCode = code.trim().toLowerCase();
    // Get affiliate record (including its primary key id, not user_id)
    const { data: affiliate } = await supabase
      .from("marketplace_affiliates")
      .select("id, user_id, referral_code")
      .ilike("referral_code", cleanCode)
      .maybeSingle();
    if (affiliate) return { id: affiliate.id, type: "affiliate", user_id: affiliate.user_id };
    // For ZBP similarly
    const { data: zbp } = await supabase
      .from("zbp_profiles")
      .select("id, user_id, referral_code")
      .ilike("referral_code", cleanCode)
      .maybeSingle();
    if (zbp) return { id: zbp.id, type: "zbp", user_id: zbp.user_id };
    return null;
  }

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setSaving(true);
    setReferralError("");

    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { router.push("/login"); return; }

    let referrerId = null;
    let referrerType = null;
    if (form.referral_code.trim()) {
      const referrer = await validateReferralCode(form.referral_code);
      if (!referrer) {
        setReferralError("Invalid referral code. Please check with your affiliate or ZBP.");
        setSaving(false);
        return;
      }
      referrerId = referrer.id;       // ✅ Store the affiliate's primary key (not user_id)
      referrerType = referrer.type;
    }

    const { error } = await supabase.from("venues").upsert({
      user_id: user.id,
      name: form.name,
      city: form.city,
      address: form.address,
      capacity: parseInt(form.capacity) || null,
      type: form.type,
      referrer_id: referrerId,
      referrer_type: referrerType,
      status: "pending",
    });

    if (error) {
      alert("Error: " + error.message);
    } else {
      alert("Venue saved successfully! Referrer linked if code was valid.");
      fetchVenue();
    }
    setSaving(false);
  }

  if (loading) return <div className="p-8 text-center">Loading...</div>;

  return (
    <div className="max-w-3xl mx-auto p-6">
      <h1 className="text-2xl font-bold mb-6">{venue ? "Edit Venue Profile" : "Create Venue Profile"}</h1>
      <form onSubmit={handleSubmit} className="space-y-4">
        <div><label className="block text-sm font-medium">Venue Name *</label><input type="text" required className="w-full border rounded p-2" value={form.name} onChange={e => setForm({...form, name: e.target.value})} /></div>
        <div><label className="block text-sm font-medium">City *</label><input type="text" required className="w-full border rounded p-2" value={form.city} onChange={e => setForm({...form, city: e.target.value})} /></div>
        <div><label className="block text-sm font-medium">Address</label><input type="text" className="w-full border rounded p-2" value={form.address} onChange={e => setForm({...form, address: e.target.value})} /></div>
        <div><label className="block text-sm font-medium">Capacity</label><input type="number" className="w-full border rounded p-2" value={form.capacity} onChange={e => setForm({...form, capacity: e.target.value})} /></div>
        <div><label className="block text-sm font-medium">Venue Type</label><select className="w-full border rounded p-2" value={form.type} onChange={e => setForm({...form, type: e.target.value})}><option value="">Select type</option><option>Restaurant</option><option>Hotel</option><option>Banquet Hall</option><option>Convention Center</option><option>Cafe</option><option>Nightclub</option></select></div>
        <div><label className="block text-sm font-medium">Referral Code (Optional)</label><input type="text" className="w-full border rounded p-2" placeholder="e.g., afff2ab745e" value={form.referral_code} onChange={e => setForm({...form, referral_code: e.target.value})} />{referralError && <p className="text-red-500 text-sm mt-1">{referralError}</p>}<p className="text-xs text-gray-500 mt-1">If you were referred by an Affiliate or ZBP, enter their code here.</p></div>
        <button type="submit" disabled={saving} className="bg-orange-600 text-white px-4 py-2 rounded hover:bg-orange-700">{saving ? "Saving..." : venue ? "Update Venue" : "Create Venue"}</button>
      </form>
    </div>
  );
}
