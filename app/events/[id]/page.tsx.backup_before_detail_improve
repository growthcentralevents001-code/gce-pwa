"use client";

import { useState, useEffect } from 'react';
import { useRouter, useParams } from 'next/navigation';
import { supabase } from '@/lib/supabaseClient';
import { Calendar, MapPin, Users, IndianRupee, Share2, Bell, Bookmark, BookmarkCheck, ArrowLeft } from 'lucide-react';

export default function EventDetailPage() {
  const router = useRouter();
  const params = useParams();
  const eventId = params.id;

  const [event, setEvent] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [isSaved, setIsSaved] = useState(false);
  const [userId, setUserId] = useState<string | null>(null);

  useEffect(() => {
    if (!eventId) return;
    const fetchEvent = async () => {
      const { data, error } = await supabase
        .from('events')
        .select('*')
        .eq('id', eventId)
        .single();
      if (error) console.error(error);
      else setEvent(data);
      setLoading(false);
    };
    fetchEvent();

    const getUser = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (user) {
        setUserId(user.id);
        const { data } = await supabase
          .from('saved_events')
          .select('id')
          .eq('user_id', user.id)
          .eq('event_id', eventId)
          .single();
        if (data) setIsSaved(true);
      }
    };
    getUser();
  }, [eventId]);

  const handleSave = async () => {
    if (!userId) {
      router.push('/login');
      return;
    }
    if (isSaved) {
      await supabase
        .from('saved_events')
        .delete()
        .eq('user_id', userId)
        .eq('event_id', eventId);
      setIsSaved(false);
    } else {
      await supabase
        .from('saved_events')
        .insert({ user_id: userId, event_id: eventId });
      setIsSaved(true);
    }
  };

  if (loading) return <div className="text-center py-12">Loading...</div>;
  if (!event) return <div className="text-center py-12">Event not found</div>;

  // Format date
  const formatDate = (dateStr: string) => {
    if (!dateStr) return 'Date TBD';
    const d = new Date(dateStr);
    return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  };

  return (
    <div className="max-w-4xl mx-auto px-4 py-8">
      <button
        onClick={() => router.back()}
        className="flex items-center text-orange-600 hover:text-orange-800 mb-4"
      >
        <ArrowLeft size={20} className="mr-1" /> Back
      </button>

      <div className="bg-white rounded-2xl shadow-2xl overflow-hidden border border-gray-100">
        <div className="w-full h-56 bg-gradient-to-r from-orange-400 to-orange-600 flex items-center justify-center text-white text-4xl font-bold">
          {event.title?.charAt(0) || 'G'}
        </div>

        <div className="p-6 md:p-8">
          <h1 className="text-3xl font-bold text-gray-900 mb-2">{event.title}</h1>
          <p className="text-gray-600 text-sm mb-4">{event.description || 'Experience the best event in town.'}</p>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl mb-6">
            <div className="flex items-center gap-2">
              <Calendar className="text-orange-500" size={18} />
              <span className="text-gray-700">{formatDate(event.date)} at {event.time || 'TBD'}</span>
            </div>
            <div className="flex items-center gap-2">
              <MapPin className="text-orange-500" size={18} />
              <span className="text-gray-700">{event.venue_name || event.city || 'Venue TBD'}</span>
            </div>
            <div className="flex items-center gap-2">
              <Users className="text-orange-500" size={18} />
              <span className="text-gray-700">{event.attending_count || 0} / {event.capacity || '∞'} attending</span>
            </div>
            <div className="flex items-center gap-2">
              <IndianRupee className="text-orange-500" size={18} />
              <span className="text-2xl font-bold text-gray-900">₹{event.price || 0}</span>
            </div>
          </div>

          <div className="flex flex-wrap gap-3">
            <button
              onClick={() => alert('Booking flow coming soon!')}
              className="flex-1 min-w-[120px] bg-orange-600 hover:bg-orange-700 text-white font-semibold py-3 px-6 rounded-xl transition-all shadow-md hover:shadow-lg"
            >
              Book Now
            </button>
            <button
              onClick={() => navigator.share?.({ title: event.title, url: window.location.href })}
              className="flex items-center justify-center gap-1 bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-3 rounded-xl transition"
            >
              <Share2 size={18} /> Share
            </button>
            <button
              onClick={() => alert('Reminder set!')}
              className="flex items-center justify-center gap-1 bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-3 rounded-xl transition"
            >
              <Bell size={18} /> Remind
            </button>
            <button
              onClick={handleSave}
              className={`flex items-center justify-center gap-1 px-4 py-3 rounded-xl transition ${
                isSaved
                  ? 'bg-orange-100 text-orange-600 hover:bg-orange-200'
                  : 'bg-gray-200 hover:bg-gray-300 text-gray-800'
              }`}
            >
              {isSaved ? <BookmarkCheck size={18} /> : <Bookmark size={18} />}
              {isSaved ? 'Saved' : 'Save'}
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
