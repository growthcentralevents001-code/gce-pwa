'use client';

import { useState, useEffect } from 'react';
import { supabase } from '@/lib/supabaseClient';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { MapPin, Loader2, ChevronDown, Calendar, Users } from 'lucide-react';

interface Event {
  id: string;
  title: string;
  date: string;
  time: string;
  venue: string;
  city: string;
  price: number;
  capacity: number;
  registered: number;
  vertical: string;
  genre?: string;
  category?: string;
  image_url?: string;
}

export default function EventsPage() {
  const router = useRouter();
  const [events, setEvents] = useState<Event[]>([]);
  const [filteredEvents, setFilteredEvents] = useState<Event[]>([]);
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');
  const [activeTab, setActiveTab] = useState('all');
  const [userCity, setUserCity] = useState<string | null>(null);
  const [locationLoading, setLocationLoading] = useState(true);
  const [locationError, setLocationError] = useState<string | null>(null);
  const [cities, setCities] = useState<string[]>([]);

  // Fetch events
  useEffect(() => {
    fetchEvents();
  }, []);

  // Fetch cities for dropdown
  useEffect(() => {
    const fetchCities = async () => {
      const { data } = await supabase.from('events').select('city');
      if (data) {
        const uniqueCities = [...new Set(data.map(e => e.city).filter(Boolean))];
        setCities(uniqueCities);
      }
    };
    fetchCities();
  }, []);

  // Detect location
  useEffect(() => {
    const detectLocation = async () => {
      setLocationLoading(true);
      setLocationError(null);

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          async (position) => {
            const { latitude, longitude } = position.coords;
            try {
              const res = await fetch(
                `https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${latitude}&longitude=${longitude}&localityLanguage=en`
              );
              const data = await res.json();
              const city = data.city || data.locality || null;
              if (city && cities.includes(city)) {
                setUserCity(city);
              } else {
                setUserCity(cities.length > 0 ? cities[0] : null);
              }
            } catch {
              setUserCity(cities.length > 0 ? cities[0] : null);
            }
            setLocationLoading(false);
          },
          (error) => {
            console.warn('Geolocation error:', error.message);
            fetchIPLocation();
          },
          { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 }
        );
      } else {
        fetchIPLocation();
      }
    };

    const fetchIPLocation = async () => {
      try {
        const res = await fetch('https://ipapi.co/json/');
        const data = await res.json();
        if (data.city && cities.includes(data.city)) {
          setUserCity(data.city);
        } else {
          setUserCity(cities.length > 0 ? cities[0] : null);
        }
      } catch {
        setUserCity(cities.length > 0 ? cities[0] : null);
      }
      setLocationLoading(false);
    };

    if (cities.length > 0) {
      detectLocation();
    }
  }, [cities]);

  const fetchEvents = async () => {
    setLoading(true);
    try {
      const { data, error } = await supabase
        .from('events')
        .select('*')
        .order('date', { ascending: true });

      if (error) throw error;
      setEvents(data || []);
      setFilteredEvents(data || []);
    } catch (error) {
      console.error('Error fetching events:', error);
    } finally {
      setLoading(false);
    }
  };

  // Filter events
  useEffect(() => {
    let filtered = events;

    if (userCity) {
      filtered = filtered.filter(
        (event) => event.city?.toLowerCase() === userCity.toLowerCase()
      );
    }

    if (searchTerm) {
      const term = searchTerm.toLowerCase();
      filtered = filtered.filter(
        (event) =>
          event.title?.toLowerCase().includes(term) ||
          event.venue?.toLowerCase().includes(term) ||
          event.city?.toLowerCase().includes(term)
      );
    }

    if (activeTab !== 'all') {
      filtered = filtered.filter((event) => event.vertical === activeTab);
    }

    setFilteredEvents(filtered);
  }, [events, userCity, searchTerm, activeTab]);

  const handleCityChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setUserCity(e.target.value || null);
  };

  if (loading) {
    return (
      <div className="container mx-auto px-4 py-10">
        <div className="text-center">Loading events...</div>
      </div>
    );
  }

  return (
    <div className="container mx-auto px-4 py-4">
      {/* Compact Location Bar - Zomato Style */}
      <div className="bg-white rounded-lg shadow-sm border border-gray-200 p-1 mb-3 flex flex-wrap items-center justify-between gap-1">
        <div className="flex items-center gap-1">
          <MapPin size={12} className="text-orange-500 flex-shrink-0" />
          {locationLoading ? (
            <div className="flex items-center gap-1 text-[10px] text-gray-500">
              <Loader2 size={12} className="animate-spin" />
              <span>Locating...</span>
            </div>
          ) : locationError ? (
            <div className="flex items-center gap-1 text-[10px] text-gray-400">
              <span>Location unavailable</span>
            </div>
          ) : (
            <div className="flex items-center gap-1">
              <span className="text-[10px] font-medium text-gray-700">
                {userCity || 'All Cities'}
              </span>
              <span className="text-[10px] text-gray-400">
                ({filteredEvents.length} events)
              </span>
            </div>
          )}
        </div>

        <div className="flex items-center gap-1">
          <select
            value={userCity || ''}
            onChange={handleCityChange}
            className="px-2 py-0.5 border border-gray-200 rounded text-[10px] focus:ring-1 focus:ring-orange-400 bg-white text-gray-700"
          >
            <option value="">All Cities</option>
            {cities.map((city) => (
              <option key={city} value={city}>
                {city}
              </option>
            ))}
          </select>
          <ChevronDown size={12} className="text-gray-400" />
        </div>
      </div>

      {/* Search Bar */}
      <div className="mb-3">
        <input
          type="text"
          placeholder="Search events, venues, or cities..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          className="w-full px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-400 focus:border-transparent"
        />
      </div>

      {/* Tabs */}
      <div className="flex gap-1 mb-3 overflow-x-auto pb-1">
        {['all', 'connect', 'marketplace', 'enterprise'].map((tab) => (
          <button
            key={tab}
            onClick={() => setActiveTab(tab)}
            className={`px-3 py-1 rounded-full text-[10px] font-medium whitespace-nowrap transition ${
              activeTab === tab
                ? 'bg-orange-600 text-white'
                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
            }`}
          >
            {tab === 'all' ? 'All Events' : tab.charAt(0).toUpperCase() + tab.slice(1)}
          </button>
        ))}
      </div>

      {/* Events Count */}
      <div className="text-[10px] text-gray-500 mb-3">
        {filteredEvents.length} events found
      </div>

      {/* Events Grid */}
      {filteredEvents.length === 0 ? (
        <div className="text-center py-10 text-gray-500">
          {userCity ? `No events found in ${userCity}` : 'No events found'}
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {filteredEvents.map((event) => {
            const colors = event.vertical === 'connect' 
              ? { bg: 'bg-blue-100', color: 'text-blue-700' }
              : event.vertical === 'marketplace'
              ? { bg: 'bg-green-100', color: 'text-green-700' }
              : { bg: 'bg-purple-100', color: 'text-purple-700' };

            return (
              <Link key={event.id} href={`/events/${event.id}`}>
                <div className="bg-white rounded-xl shadow-md overflow-hidden cursor-pointer hover:shadow-lg transition">
                  <div className="h-28 bg-gradient-to-r from-orange-400 to-orange-600 flex items-center justify-center">
                    <span className="text-4xl">🎉</span>
                  </div>
                  <div className="p-3">
                    <div className="flex justify-between items-start mb-1">
                      <h3 className="font-bold text-sm truncate">{event.title}</h3>
                      <span
                        className="text-[10px] px-1.5 py-0.5 rounded-full whitespace-nowrap ml-1"
                        style={{ background: colors.bg, color: colors.color }}
                      >
                        {event.vertical}
                      </span>
                    </div>
                    <div className="space-y-0.5 text-[10px] text-gray-600">
                      <div className="flex items-center gap-1">
                        <Calendar size={12} /> {event.date} at {event.time}
                      </div>
                      <div className="flex items-center gap-1">
                        <MapPin size={12} /> {event.venue}, {event.city}
                      </div>
                      <div className="flex items-center gap-1">
                        <Users size={12} /> {event.registered} / {event.capacity} attending
                      </div>
                    </div>
                    <div className="mt-2 flex justify-between items-center">
                      <span className="text-base font-bold text-orange-600">₹{event.price}</span>
                      <span className="px-2 py-0.5 bg-orange-600 text-white text-[10px] rounded-full">View</span>
                    </div>
                  </div>
                </div>
              </Link>
            );
          })}
        </div>
      )}
    </div>
  );
}
